generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum LeadSource {
  WEBSITE
  ADS
  CALL
  REFERRAL
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  LOST
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyAvailabilityStatus {
  AVAILABLE
  BOOKED
  SOLD
  RENTED
}

enum ClientType {
  BUYER
  SELLER
  INVESTOR
  TENANT
}

enum InteractionType {
  CALL
  SMS
  EMAIL
  VISIT
  NOTE
}

enum DealStage {
  NEGOTIATION
  AGREEMENT
  CLOSED
}

enum DocumentCategory {
  AGREEMENT
  CONTRACT
  ID_PROOF
  OTHER
}

enum ReminderStatus {
  PENDING
  DONE
  MISSED
}

enum NotificationType {
  REMINDER
  LEAD
  DEAL
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads    Lead[]         @relation("AssignedLeads")
  createdLeads     Lead[]         @relation("CreatedLeads")
  listedProperties Property[]     @relation("ListedProperties")
  interactions     Interaction[]
  deals            Deal[]
  reminders        Reminder[]
  notifications    Notification[]
}

model Lead {
  id          String     @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  source      LeadSource @default(MANUAL)
  budgetMin   Float?
  budgetMax   Float?
  preferences String?
  status      LeadStatus @default(NEW)
  followUpAt  DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignedAgentId String?
  assignedAgent   User?   @relation("AssignedLeads", fields: [assignedAgentId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedLeads", fields: [createdById], references: [id])

  client       Client?
  interactions Interaction[]
  reminders    Reminder[]
}

model Property {
  id                 String                     @id @default(cuid())
  title              String
  type               PropertyType
  description        String?
  address            String
  city               String
  state              String?
  country            String?
  latitude           Float?
  longitude          Float?
  price              Float
  sizeSqft           Float?
  bedrooms           Int?
  bathrooms          Int?
  amenities          String?
  availabilityStatus PropertyAvailabilityStatus @default(AVAILABLE)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  listedByAgentId String?
  listedByAgent   User?   @relation("ListedProperties", fields: [listedByAgentId], references: [id])

  images    PropertyImage[]
  deals     Deal[]
  documents Document[]
}

model PropertyImage {
  id        String   @id @default(cuid())
  imageUrl  String
  publicId  String?
  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Client {
  id          String     @id @default(cuid())
  fullName    String
  phone       String?
  email       String?
  clientType  ClientType
  preferences String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  linkedLeadId String? @unique
  linkedLead   Lead?   @relation(fields: [linkedLeadId], references: [id])

  interactions Interaction[]
  deals        Deal[]
  documents    Document[]
  reminders    Reminder[]
}

model Interaction {
  id         String          @id @default(cuid())
  type       InteractionType
  summary    String
  happenedAt DateTime        @default(now())
  createdAt  DateTime        @default(now())

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  agentId String
  agent   User   @relation(fields: [agentId], references: [id])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  stage             DealStage @default(NEGOTIATION)
  dealValue         Float
  commissionPercent Float
  commissionAmount  Float
  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  agentId String
  agent   User   @relation(fields: [agentId], references: [id])

  documents Document[]
}

model Document {
  id        String           @id @default(cuid())
  fileName  String
  fileUrl   String
  publicId  String?
  category  DocumentCategory @default(OTHER)
  createdAt DateTime         @default(now())

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Reminder {
  id          String         @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime
  status      ReminderStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  isRead    Boolean          @default(false)
  type      NotificationType @default(SYSTEM)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
